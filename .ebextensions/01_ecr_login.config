container_commands:
  01_ecr_login:
    command: |
      #!/bin/bash
      set -x  # Enable debug output

      LOG_FILE="/var/log/ecr-login-debug.log"
      exec &> >(tee -a "$LOG_FILE")

      echo "========================================="
      echo "ECR Login Debug - Started at $(date)"
      echo "========================================="

      # Check if running as root
      echo "Current user: $(whoami)"
      echo "Current UID: $(id -u)"

      # Check Docker availability
      echo "Checking Docker..."
      if command -v docker &> /dev/null; then
        echo "✓ Docker command found"
        docker --version || echo "Warning: docker --version failed"
      else
        echo "✗ Docker command NOT found"
        echo "PATH: $PATH"
        exit 1
      fi

      # Wait for Docker daemon
      echo "Waiting for Docker daemon..."
      for i in {1..30}; do
        if docker info &> /dev/null; then
          echo "✓ Docker daemon is ready"
          break
        fi
        echo "Attempt $i/30: Docker not ready yet..."
        sleep 2
      done

      # Verify Docker is actually ready
      if ! docker info &> /dev/null; then
        echo "✗ Docker daemon failed to start after 60 seconds"
        systemctl status docker || echo "Cannot check Docker service status"
        exit 1
      fi

      # Check AWS CLI
      echo "Checking AWS CLI..."
      if command -v aws &> /dev/null; then
        echo "✓ AWS CLI found"
        aws --version || echo "Warning: aws --version failed"
      else
        echo "✗ AWS CLI NOT found"
        exit 1
      fi

      # Check instance metadata service
      echo "Checking instance metadata..."
      REGION=$(curl -s -m 5 http://169.254.169.254/latest/meta-data/placement/region 2>&1)
      if [ $? -eq 0 ] && [ ! -z "$REGION" ]; then
        echo "✓ Region from metadata: $REGION"
      else
        echo "✗ Failed to get region from metadata"
        echo "Curl output: $REGION"
        echo "Trying with IMDSv2..."
        TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
        REGION=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
        if [ ! -z "$REGION" ]; then
          echo "✓ Region from IMDSv2: $REGION"
        else
          echo "✗ Still failed to get region"
          exit 1
        fi
      fi

      # Check IAM instance profile
      echo "Checking IAM instance profile..."
      PROFILE=$(curl -s -m 5 http://169.254.169.254/latest/meta-data/iam/security-credentials/ 2>&1)
      if [ $? -eq 0 ] && [ ! -z "$PROFILE" ]; then
        echo "✓ Instance profile found: $PROFILE"
      else
        echo "✗ No instance profile attached!"
        echo "Output: $PROFILE"
        echo "This means .ebextensions/00_instance_profile.config didn't work"
        exit 1
      fi

      # Test AWS credentials
      echo "Testing AWS credentials..."
      ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text 2>&1)
      if [ $? -eq 0 ] && [ ! -z "$ACCOUNT_ID" ]; then
        echo "✓ AWS credentials work! Account ID: $ACCOUNT_ID"
      else
        echo "✗ AWS credentials failed!"
        echo "Error: $ACCOUNT_ID"
        exit 1
      fi

      # Build ECR registry URL
      ECR_REGISTRY="${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
      echo "ECR Registry: $ECR_REGISTRY"

      # Get ECR password
      echo "Getting ECR login password..."
      ECR_PASSWORD=$(aws ecr get-login-password --region $REGION 2>&1)
      if [ $? -eq 0 ] && [ ! -z "$ECR_PASSWORD" ]; then
        echo "✓ ECR password obtained (length: ${#ECR_PASSWORD} chars)"
      else
        echo "✗ Failed to get ECR password!"
        echo "Error: $ECR_PASSWORD"
        exit 1
      fi

      # Login to ECR
      echo "Logging into ECR..."
      LOGIN_OUTPUT=$(echo "$ECR_PASSWORD" | docker login --username AWS --password-stdin $ECR_REGISTRY 2>&1)
      if [ $? -eq 0 ]; then
        echo "✓ Successfully logged into ECR!"
        echo "$LOGIN_OUTPUT"
      else
        echo "✗ Docker login to ECR failed!"
        echo "Error: $LOGIN_OUTPUT"
        exit 1
      fi

      echo "========================================="
      echo "ECR Login Debug - Completed at $(date)"
      echo "✅ ALL CHECKS PASSED!"
      echo "========================================="

      exit 0
    ignoreErrors: false
